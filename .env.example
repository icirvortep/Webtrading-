# ---- Přístup k burze (nikdy necommituj skutečné klíče!) ----
# API klíč vytvoř s oprávněním: obchodování s futures. NIKDY ne s výběry.
# Pokud burza umožňuje omezení na IP, nastav IP svého serveru.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# jen pro OKX / Bitget / KuCoin:
EXCHANGE_API_PASSWORD=

# ---- Zabezpečení webhooku ----
# Vygeneruj: openssl rand -hex 32
WEBHOOK_SECRET=

# ---- Notifikace do Telegramu (volitelné) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Přepisy konfigurace ----
ATB_MODE=paper          # paper | live
ATB_DRY_RUN=true
ATB_EXCHANGE=bybit
ATB_TESTNET=true
ATB_RISK_PCT=2.0
ATB_MAX_LEVERAGE=20
ATB_KILL_SWITCH=false
ATB_WEBHOOK_PORT=8080
ATB_LOG_LEVEL=INFO
